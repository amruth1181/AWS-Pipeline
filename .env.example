# Copy to .env for local development. Never commit .env.
AWS_PROFILE=urbanmove
AWS_REGION=eu-west-3
ENV=dev

# Ingestion
VELIB_STATUS_URL=https://velib-metropole-opendata.smovengo.cloud/opendata/Velib_Metropole/station_status.json
VELIB_INFO_URL=https://velib-metropole-opendata.smovengo.cloud/opendata/Velib_Metropole/station_information.json
POLL_INTERVAL_MINUTES=2

# Local API (docker compose + DynamoDB Local)
DYNAMODB_ENDPOINT_URL=http://localhost:8001
STATIONS_TABLE=urbanmove-dev-stations
ALERTS_TABLE=urbanmove-dev-alerts
STATION_CACHE_TTL_SECONDS=30
DEV_AUTH_BYPASS=1          # local only, never set in AWS

# Cognito (filled after Phase 4)
COGNITO_USER_POOL_ID=
COGNITO_WEB_CLIENT_ID=
COGNITO_SERVICE_CLIENT_ID=
COGNITO_DOMAIN=

# Alerts
ALERT_EMAIL=you@example.com
